# Copy to .env and adjust (`make setup` does this). Never commit .env.
#
# You do NOT have to set anything here. `make up` starts Void with its own built-in analyst
# and its own Tor: no AI key, no model download, no Tor Browser.
# To optionally add an AI (ChatGPT API, Claude, Gemini...), click "AI model (optional)" in the web UI.

# ---- Optional AI provider (pre-configure instead of using the UI) ---------------------
# builtin (default, no key) | openai | anthropic | gemini | openrouter | groq | mistral | custom | ollama
LLM_PROVIDER=
# Exact model ID from your provider's documentation (required for most providers).
LLM_MODEL=
# Only needed for provider=custom (any OpenAI-compatible server), e.g. http://host.docker.internal:1234/v1
LLM_BASE_URL=
# Generic key, or use the vendor-specific names below. Settings saved in the UI take precedence.
LLM_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# false = hide/lock the settings dialog and use only the values above (shared deployments).
ALLOW_UI_CONFIG=true

# ---- Web UI ---------------------------------------------------------------------------
# Host port for the web UI (bound to 127.0.0.1 only).
APP_PORT=8000
# If you expose the UI beyond localhost, set a long random token (e.g. `openssl rand -hex 32`).
# The UI will ask for it once and the API will require it as a Bearer token.
ACCESS_TOKEN=
# Without a token, only localhost host names are served. Add others here (comma-separated).
ALLOWED_HOSTS=

# ---- Tor ------------------------------------------------------------------------------
# auto = Void starts its own Tor (default). Or point at an existing one: socks5h://127.0.0.1:9050
TOR_PROXY=auto

# ---- Dark web search ------------------------------------------------------------------
# Comma-separated name=url_template pairs; {query} is replaced with the URL-encoded query.
# Leave empty to use the built-in list of 16 engines.
SEARCH_ENGINES=
# Unique results kept after merging all 16 engines / pages read and analysed.
MAX_RESULTS=40
MAX_FETCH=8
# Extra pages reached by following relevant links out of the pages read (0 = off).
CRAWL_LINKS=8
FETCH_TIMEOUT=45
# Mask emails, card numbers and "password: ..." patterns before the AI sees them.
REDACT_PII=true
# Only .onion hosts are fetched unless this is true.
ALLOW_CLEARNET=false
# Parallel investigations allowed at once.
MAX_CONCURRENT=2

# ---- Optional local model (only with `make up-local`) ---------------------------------
OLLAMA_MODEL=llama3.1:8b
OLLAMA_NUM_CTX=8192
